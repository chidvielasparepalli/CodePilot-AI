# Google AI Studio key. Keep the real value in ignored local .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=3072
GEMINI_TIMEOUT_SECONDS=75

# Use a dedicated, non-default persistent Chrome data directory.
# Chrome 136+ blocks Playwright debugging in the normal Google Chrome User Data folder.
PLAYWRIGHT_PROFILE_DIR=automation_chrome_profile
CHROME_PROFILE_NAME=Default
PLAYWRIGHT_CHANNEL=chrome
LMS_URL=https://learning.ccbp.in/problems-set

# API-only coding mode: browser login/navigation, API draft save and submission.
# Set to hybrid to show code in the editor too; set to browser for UI submission.
CCBP_API_MODE=api
CCBP_API_TIMEOUT_SECONDS=25
CCBP_APP_VERSION=1128

# Automation controls
MAX_ATTEMPTS_PER_QUESTION=6
MAX_QUESTION_BANK_PAGES=500
RESULT_TIMEOUT_SECONDS=50
QUESTION_DELAY_SECONDS=0.8
MAX_CONSECUTIVE_ERRORS=8
